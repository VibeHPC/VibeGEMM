{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibegemm.dev/schemas/knowledge-record.schema.json",
  "title": "VibeGEMM GPU knowledge record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "level", "name", "summary", "primitives",
    "strategy", "parameters", "constraints", "architectures", "source",
    "tags", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
    "level": {"enum": ["atom", "tile", "collective", "kernel", "device"]},
    "name": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 20},
    "primitives": {
      "type": "array", "items": {"type": "string"}, "uniqueItems": true
    },
    "strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["intent", "mechanism", "expected_benefit"],
      "properties": {
        "intent": {"type": "string"},
        "mechanism": {"type": "string"},
        "expected_benefit": {"type": "string"},
        "tradeoffs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["choice", "integer", "shape", "boolean", "dtype"]},
          "description": {"type": "string"},
          "values": {"type": "array"},
          "default": {}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "expression", "rationale"],
        "properties": {
          "type": {"enum": ["architecture", "dtype", "layout", "shape", "resource", "dependency", "semantic"]},
          "expression": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "architectures": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sm[0-9]+a?$"}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["library", "version", "license", "references"],
      "properties": {
        "library": {"type": "string"},
        "version": {"type": "string"},
        "license": {"type": "string"},
        "references": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "line_start", "line_end", "symbol", "evidence"],
            "properties": {
              "path": {"type": "string"},
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "symbol": {"type": "string"},
              "evidence": {"type": "string", "minLength": 10}
            }
          }
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["candidate", "curated", "deprecated"]},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}

